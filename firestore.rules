rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.matches('.*admin.*') ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'admin@college.edu'
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.email.matches('.*umpire.*') ||
        request.auth.token.role == 'umpire' ||
        request.auth.token.email == 'umpire@college.edu'
      );
    }

    // Players Collection:
    // Anyone can read (public). Anyone can register (create).
    // Only admin can update or delete players.
    match /players/{playerId} {
      allow read: if true;
      allow create: if request.resource.data.name is string &&
                      request.resource.data.roll is string &&
                      request.resource.data.role is string;
      allow update, delete: if isAdmin();
    }

    // Config / Teams Collection:
    // Anyone can read teams. Only admin can write or re-balance teams.
    match /cfg/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Matches Collection:
    // Anyone can read live scores and match history.
    // Any signed-in staff (admin or umpire) can create or update match scores.
    // Admin can delete match records.
    match /matches/{matchId} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if isAdmin();

      // Ball subcollection if nested, or array in doc
      match /balls/{ballId} {
        allow read: if true;
        allow write: if isStaff();
      }
    }
  }
}
